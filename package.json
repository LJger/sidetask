{
  "name": "sidetask",
  "version": "1.3.2",
  "private": true,
  "description": "侧记 · 一个安静待在桌面侧边的本地任务工具",
  "type": "module",
  "author": "SideTask",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "tauri dev",
    "dev": "tauri dev",
    "preview": "node scripts/preview.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "build:win": "node scripts/build-windows.mjs",
    "build:portable": "node scripts/build-windows.mjs --portable",
    "build:dir": "tauri build --no-bundle",
    "build:frontend": "node scripts/build-frontend.mjs",
    "test:native": "node scripts/native-tests.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "webdriverio": "9.31.8"
  }
}
